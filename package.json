{
  "name": "gba-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A browser-based Game Boy Advance emulator powered by mGBA (WebAssembly), with save states, fast-forward and rewind.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node serve.mjs",
    "serve": "node serve.mjs",
    "test": "node tests/e2e.mjs",
    "demo": "python3 tools/make-demo-rom.py",
    "test-roms": "python3 tools/make-test-roms.py tests/roms"
  },
  "dependencies": {
    "@thenick775/mgba-wasm": "^2.5.1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  }
}
